---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import { sortPosts, getCategoryCounts } from '../../lib/posts';

const posts = sortPosts(await getCollection('blog'));
const categories = getCategoryCounts(posts);
---

<MainLayout title="Archive | AInothing.top" description="The full AInothing.top archive covering AI signals, revenue breakdowns, tool analysis, and growth playbooks.">
  <section class="archive-hero card-surface">
    <span class="section-label">Archive</span>
    <h1>All posts in one place.</h1>
    <p>
      Browse the complete index of essays, breakdowns, and operating notes across AI, internet business,
      audience growth, and solo publishing.
    </p>
  </section>

  <section class="archive-layout">
    <div>
      <ul class="post-list">
        {posts.map((post) => (
          <li class="card-surface">
            <a href={`/blog/${post.id}/`}>
              <div>
                <span class="badge">{post.data.category}</span>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
              </div>
              <span class="date">{post.data.pubDate.toISOString().slice(0, 10)}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <aside class="sidebar card-surface">
      <p class="kicker">Category mix</p>
      <h3>What the archive covers</h3>
      <a class="sidebar-cta" href="/revenue">Go to the revenue hub →</a>
      <ul>
        {categories.map((item) => (
          <li>
            <span>{item.category}</span>
            <strong>{item.count}</strong>
          </li>
        ))}
      </ul>
    </aside>
  </section>
</MainLayout>

<style>
  .archive-hero,
  .sidebar {
    padding: 1.35rem;
  }

  .archive-hero p {
    max-width: 48rem;
    margin-bottom: 0;
    color: var(--muted);
  }

  .archive-layout {
    display: grid;
    grid-template-columns: minmax(0, 2.2fr) minmax(280px, 0.9fr);
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .post-list,
  .sidebar ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-list li + li {
    margin-top: 1rem;
  }

  .post-list a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem;
    color: inherit;
  }

  .post-list h2 {
    font-size: 1.55rem;
    margin: 0.45rem 0;
  }

  .badge {
    color: var(--accent);
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .date {
    color: var(--muted);
    white-space: nowrap;
    font-size: 0.95rem;
  }

  .sidebar {
    height: fit-content;
    position: sticky;
    top: 6.7rem;
  }

  .sidebar h3 {
    margin-bottom: 0.6rem;
  }

  .sidebar-cta {
    display: inline-flex;
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .sidebar li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid rgba(6, 27, 49, 0.08);
  }

  .sidebar li:last-child {
    border-bottom: 0;
  }

  @media (max-width: 900px) {
    .archive-layout {
      grid-template-columns: 1fr;
    }

    .post-list a {
      flex-direction: column;
    }

    .sidebar {
      position: static;
    }
  }
</style>
