---
import MainLayout from '../../layouts/MainLayout.astro';

const storefronts = [
  'Bakery', 'Florist', 'Bookshop', 'Tea salon', 'Café', 'Apothecary',
  'Watchmaker', 'Toy shop', 'Chocolatier', 'Pottery studio', 'Mapmaker', 'Antique shop',
];

const gallery = [
  { src: '/portfolio/lantern-vale/shopfronts.jpg', label: '32 coordinated shopfronts', alt: 'Overview of 32 watercolor European shopfront illustrations' },
  { src: '/portfolio/lantern-vale/props.jpg', label: '16 scene-building props', alt: 'Overview of 16 watercolor street prop illustrations' },
  { src: '/portfolio/lantern-vale/details.jpg', label: 'Curated architectural detail', alt: 'Close-up details from the Twilight Lane collection' },
  { src: '/portfolio/lantern-vale/scene-builder.jpg', label: 'Designed to mix and match', alt: 'A street scene composed from Twilight Lane assets' },
  { src: '/portfolio/lantern-vale/transparency.jpg', label: 'Clean transparent PNGs', alt: 'Transparent background proof for the PNG illustrations' },
];
---

<MainLayout
  title="Lantern Vale Studio | AInothing"
  description="Twilight Lane Shopfront Builder: a coordinated 48-piece watercolor clipart collection by Lantern Vale Studio."
>
  <article class="portfolio-page">
    <section class="portfolio-hero shell" id="top">
      <div class="portfolio-intro" data-reveal>
        <p class="overline">AInothing / Independent studio portfolio</p>
        <div class="studio-lockup">
          <span aria-hidden="true">LV</span>
          <p><strong>Lantern Vale Studio</strong><small>Illustrated worlds, built piece by piece</small></p>
        </div>
        <h1>Twilight Lane<br /><em>Shopfront Builder.</em></h1>
        <p class="lede">A coordinated watercolor clipart system for building charming old-European streets, storybook neighborhoods, invitations and small-business scenes.</p>
        <dl>
          <div><dt>48</dt><dd>Unique assets</dd></div>
          <div><dt>300</dt><dd>DPI metadata</dd></div>
          <div><dt>4K</dt><dd>Maximum long side</dd></div>
        </dl>
      </div>
      <figure class="cover" data-reveal>
        <img src="/portfolio/lantern-vale/cover.jpg" width="1600" height="1600" alt="Twilight Lane Shopfront Builder collection cover" />
        <figcaption>Portfolio sample · 2026</figcaption>
      </figure>
    </section>

    <section class="collection-note" id="collection">
      <div class="shell note-grid">
        <div data-reveal><p class="overline">The collection / 01</p><h2>One visual language.<br />Dozens of possible streets.</h2></div>
        <p data-reveal>Rather than a loose assortment of decorative objects, Twilight Lane is built as a scene-making system. Thirty-two front-facing shop facades and sixteen compatible street details share a restrained watercolor palette, consistent viewing angle and storybook architectural character.</p>
      </div>
    </section>

    <section class="gallery shell" aria-label="Twilight Lane portfolio gallery">
      {gallery.map((item, index) => (
        <figure class:list={['gallery-card', { wide: index === 0 }]} data-reveal>
          <img src={item.src} width="1600" height="1600" alt={item.alt} loading="lazy" />
          <figcaption><span>0{index + 1}</span>{item.label}</figcaption>
        </figure>
      ))}
    </section>

    <section class="inventory shell">
      <div data-reveal><p class="overline">Selected storefronts</p><h2>Variety without losing cohesion.</h2></div>
      <ul data-reveal>{storefronts.map((storefront) => <li>{storefront}</li>)}</ul>
    </section>

    <section class="process" id="process">
      <div data-reveal><span>01</span><h3>Art direction</h3><p>Unified palette, straight-on facades and repeatable proportions establish the collection before production begins.</p></div>
      <div data-reveal><span>02</span><h3>Curation & refinement</h3><p>Every asset is individually selected, named, cleaned and adjusted to preserve its structure and shared visual language.</p></div>
      <div data-reveal><span>03</span><h3>Technical QA</h3><p>All 48 files are checked on light and dark backgrounds for transparency, residue, edge quality and ZIP integrity.</p></div>
    </section>

    <section class="studio-about shell" data-reveal>
      <p class="overline">About Lantern Vale Studio</p>
      <h2>Cohesive digital illustration systems for makers and storytellers.</h2>
      <p>Our work combines AI-assisted image creation with human-led concept development, selection, background cleanup, compositional refinement and technical quality assurance. The finished collection is designed for journals, paper crafts, educational projects, stationery, branding accents and digital compositions.</p>
      <div class="portfolio-safety"><strong>Portfolio preview</strong><span>This page displays promotional composites only. Customer PNG files and production source files are not publicly hosted here.</span></div>
    </section>
  </article>
</MainLayout>

<style>
  .portfolio-page { --vale:#17363b; --vale-soft:#526c70; --vale-paper:#eee7da; --vale-cream:#fbf7ef; --vale-gold:#bc8d45; background:var(--vale-paper); color:var(--vale); }
  .portfolio-hero { display:grid; grid-template-columns:minmax(320px,.86fr) minmax(460px,1.14fr); align-items:center; gap:clamp(3rem,7vw,7rem); padding:clamp(4rem,9vw,8rem) 0; }
  .portfolio-intro>.overline { color:var(--vale-gold); }
  .studio-lockup { display:flex; align-items:center; gap:.9rem; margin:2rem 0 3rem; }
  .studio-lockup>span { display:grid; place-items:center; width:48px; aspect-ratio:1; border:1px solid var(--vale); font-family:var(--font-display); font-style:italic; }
  .studio-lockup p { display:grid; margin:0; line-height:1.1; }
  .studio-lockup strong { font-family:var(--font-display); font-size:1.2rem; }
  .studio-lockup small { margin-top:.35rem; color:var(--vale-soft); font-family:var(--font-mono); font-size:.56rem; letter-spacing:.1em; text-transform:uppercase; }
  h1 { max-width:780px; font-size:clamp(4rem,7vw,8rem); line-height:.78; color:var(--vale); }
  h1 em { color:var(--vale-gold); font-weight:500; }
  .lede { max-width:39rem; margin:2rem 0 2.5rem; color:var(--vale-soft); font-size:1.05rem; line-height:1.8; }
  dl { display:flex; flex-wrap:wrap; gap:.8rem; margin:0; }
  dl div { min-width:112px; padding:1rem 1.15rem; border:1px solid rgba(23,54,59,.2); }
  dt { font-family:var(--font-display); font-size:2rem; line-height:1; }
  dd { margin:.5rem 0 0; color:var(--vale-soft); font-family:var(--font-mono); font-size:.56rem; letter-spacing:.09em; text-transform:uppercase; }
  .cover { margin:0; padding:.8rem; background:var(--vale-cream); box-shadow:0 30px 80px rgba(15,42,47,.16); transform:rotate(1deg); }
  .cover figcaption { padding:.7rem .2rem 0; color:var(--vale-soft); font-family:var(--font-mono); font-size:.58rem; letter-spacing:.12em; text-align:right; text-transform:uppercase; }

  .collection-note { padding:clamp(5rem,9vw,8rem) 0; background:var(--vale); color:var(--vale-cream); }
  .note-grid { display:grid; grid-template-columns:1fr 1fr; gap:clamp(3rem,8vw,8rem); }
  .collection-note .overline { color:#e2b86e; }
  .collection-note h2 { color:var(--vale-cream); font-size:clamp(3.2rem,5vw,6.2rem); }
  .collection-note .note-grid>p { align-self:end; max-width:40rem; color:rgba(251,247,239,.7); font-size:1.05rem; line-height:1.85; }

  .gallery { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.25rem; padding:clamp(5rem,9vw,8rem) 0; }
  .gallery-card { margin:0; padding:.7rem; background:var(--vale-cream); border:1px solid rgba(23,54,59,.1); }
  .gallery-card.wide { grid-column:1/-1; }
  .gallery-card figcaption { display:flex; gap:.9rem; padding:1rem .35rem .25rem; color:var(--vale); font-family:var(--font-mono); font-size:.63rem; letter-spacing:.08em; text-transform:uppercase; }
  .gallery-card figcaption span { color:var(--vale-gold); }

  .inventory { display:grid; grid-template-columns:1fr 1.1fr; gap:clamp(3rem,7vw,7rem); padding:1rem 0 clamp(5rem,9vw,8rem); border-top:1px solid rgba(23,54,59,.2); }
  .inventory h2,.studio-about h2 { color:var(--vale); font-size:clamp(3rem,5vw,6rem); }
  .inventory ul { display:grid; grid-template-columns:repeat(3,1fr); margin:0; padding:0; list-style:none; border-top:1px solid rgba(23,54,59,.2); }
  .inventory li { padding:1rem .4rem; border-bottom:1px solid rgba(23,54,59,.2); font-size:.78rem; }

  .process { display:grid; grid-template-columns:repeat(3,1fr); background:#d2bd98; }
  .process>div { min-height:320px; padding:clamp(2rem,4vw,4rem); border-right:1px solid rgba(23,54,59,.18); }
  .process span { color:#875e25; font-family:var(--font-mono); font-size:.65rem; letter-spacing:.14em; }
  .process h3 { margin:4rem 0 1rem; color:var(--vale); font-size:clamp(2rem,3vw,3rem); }
  .process p { color:var(--vale-soft); font-size:.88rem; line-height:1.75; }

  .studio-about { padding:clamp(5rem,9vw,9rem) 0; }
  .studio-about h2 { max-width:1000px; }
  .studio-about>p:nth-of-type(2) { max-width:760px; margin:2.5rem 0 0 auto; color:var(--vale-soft); font-size:1rem; line-height:1.85; }
  .portfolio-safety { display:grid; grid-template-columns:.35fr 1fr; gap:2rem; margin-top:4rem; padding:1.5rem 0; border-top:1px solid rgba(23,54,59,.2); border-bottom:1px solid rgba(23,54,59,.2); }
  .portfolio-safety strong { font-family:var(--font-mono); font-size:.65rem; letter-spacing:.1em; text-transform:uppercase; }
  .portfolio-safety span { color:var(--vale-soft); font-size:.8rem; }

  @media(max-width:900px){
    .portfolio-hero,.note-grid,.inventory { grid-template-columns:1fr; }
    .cover { transform:none; }
    .process { grid-template-columns:1fr; }
    .process>div { min-height:auto; border-right:0; border-bottom:1px solid rgba(23,54,59,.18); }
    .process h3 { margin-top:2rem; }
  }
  @media(max-width:620px){
    .gallery { grid-template-columns:1fr; }
    .gallery-card.wide { grid-column:auto; }
    .inventory ul { grid-template-columns:repeat(2,1fr); }
    .portfolio-safety { grid-template-columns:1fr; gap:.7rem; }
  }
</style>
