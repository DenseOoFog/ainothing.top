<div class="ambient-field" aria-hidden="true">
  <div class="ambient-orb orb-one"></div>
  <div class="ambient-orb orb-two"></div>
  <div class="ambient-grain"></div>
</div>

<script is:inline>
  (() => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let targetX = window.innerWidth * 0.72;
    let targetY = window.innerHeight * 0.28;
    let currentX = targetX;
    let currentY = targetY;
    let frame;

    const render = () => {
      currentX += (targetX - currentX) * 0.045;
      currentY += (targetY - currentY) * 0.045;
      document.documentElement.style.setProperty('--field-x', `${currentX}px`);
      document.documentElement.style.setProperty('--field-y', `${currentY}px`);
      frame = requestAnimationFrame(render);
    };

    window.addEventListener('pointermove', (event) => {
      targetX = event.clientX;
      targetY = event.clientY;
    }, { passive: true });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(frame);
      else frame = requestAnimationFrame(render);
    });

    render();
  })();
</script>

<style>
  .ambient-field {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    isolation: isolate;
  }

  .ambient-field::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(460px circle at var(--field-x, 72vw) var(--field-y, 28vh), rgba(65, 94, 255, 0.15), transparent 66%),
      radial-gradient(340px circle at calc(var(--field-x, 72vw) * 0.45) calc(var(--field-y, 28vh) * 1.65), rgba(185, 255, 102, 0.13), transparent 68%);
  }

  .ambient-orb {
    position: absolute;
    width: min(48vw, 700px);
    aspect-ratio: 1;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.16;
    will-change: transform;
  }

  .orb-one {
    top: -24%;
    right: -14%;
    background: var(--secondary);
    animation: field-drift-one 18s ease-in-out infinite alternate;
  }

  .orb-two {
    bottom: -30%;
    left: -18%;
    background: var(--signal);
    animation: field-drift-two 24s ease-in-out infinite alternate;
  }

  .ambient-grain {
    position: absolute;
    inset: -50%;
    opacity: 0.035;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.82' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.72'/%3E%3C/svg%3E");
    animation: grain-shift 0.9s steps(2) infinite;
  }

  @keyframes field-drift-one {
    to { transform: translate(-12vw, 18vh) scale(1.18); }
  }

  @keyframes field-drift-two {
    to { transform: translate(18vw, -15vh) scale(0.84); }
  }

  @keyframes grain-shift {
    0% { transform: translate3d(-2%, -1%, 0); }
    50% { transform: translate3d(2%, 1%, 0); }
    100% { transform: translate3d(0, -2%, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ambient-orb,
    .ambient-grain { animation: none; }
  }
</style>
